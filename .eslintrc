{
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:prettier/recommended",
      "next/core-web-vitals", "next/typescript", "standard", "prettier", "plugin:tailwindcss/recommended"

    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "quotes": ["error", "single"],
      "semi": ["error", "always"]
    }
  }