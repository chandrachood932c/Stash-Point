PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/stash_point
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
COOKIE_NAME=stash-point-session
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Stash Point <no-reply@example.com>"

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
PUBLIC_FILE_BASE_URL=http://localhost:5000/api/files/download
MAX_FILE_SIZE_MB=50
